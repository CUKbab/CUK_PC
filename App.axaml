<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CUK.App"
             xmlns:local="using:CUK"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />

        <!-- Card Container Style -->
        <Style Selector="Border.menuCard">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style Selector="RadioButton.navBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.navBtn:checked">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight2}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="RadioButton.navBtn:pointerover:not(:checked)">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3}" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="HeaderPrimaryBrush" Color="#1F2937" />
                    <SolidColorBrush x:Key="SubTextBrush" Color="#6B7280" />
                    <SolidColorBrush x:Key="AccentBadgeBrush" Color="#EEF2FF" />
                    <SolidColorBrush x:Key="AccentBadgeTextBrush" Color="#4F46E5" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#18181B" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#27272A" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#3F3F46" />
                    <SolidColorBrush x:Key="HeaderPrimaryBrush" Color="#F9FAFB" />
                    <SolidColorBrush x:Key="SubTextBrush" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="AccentBadgeBrush" Color="#312E81" />
                    <SolidColorBrush x:Key="AccentBadgeTextBrush" Color="#A5B4FC" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>